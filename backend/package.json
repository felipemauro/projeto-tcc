{
  "name": "sali-backend",
  "version": "1.0.0",
  "description": "API REST do Sistema de Agendamento de Laboratórios Acadêmicos com Controle Multiusuário (UEMG Divinópolis)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/migrate.js --reset && node db/seed.js",
    "db:disciplinas": "node db/importar-disciplinas.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "author": "Felipe Mauro da Silva",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
